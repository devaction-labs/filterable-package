{
    "name": "devaction-labs/filterable-package",
    "description": "A Laravel package for filterable traits and classes.",
    "keywords": [
        "laravel",
        "filter",
        "filterable",
        "query-builder",
        "eloquent",
        "search",
        "pagination",
        "dynamic-filters"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "DevAction Labs",
            "email": "alex@devaction.com.br"
        }
    ],
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "illuminate/cache": "^11|^12",
        "illuminate/database": "^11|^12",
        "illuminate/http": "^11|^12",
        "illuminate/support": "^11|^12"
    },
    "require-dev": {
        "laravel/pint": "^1.27.0",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2.3.4",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "DevactionLabs\\FilterablePackage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "refacto": "rector",
        "lint": "pint",
        "test:refacto": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test:coverage": "pest --coverage --min=80",
        "test:coverage-html": "pest --coverage-html coverage",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "analyse": [
            "@test:lint",
            "@test:types"
        ]
    }
}
